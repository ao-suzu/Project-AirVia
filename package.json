{
  "name": "project-airvia",
  "version": "1.0.0",
  "description": "Local Wi-Fi Host and Micro-Web Platform powered by Windows Mobile Hotspot",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build:exe": "npx pkg@5.8.1 . --targets node18-win-x64 --output dist/AirVia.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "apps/**/*"
    ]
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3"
  }
}
